# Shoppy Root Environment Variables Template

# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shoppy_dev
POSTGRES_PORT=5432

# Backend Connection String (pointing to local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoppy_dev?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="shoppy_super_secret_access_key_change_me_in_production_12345"
JWT_REFRESH_SECRET="shoppy_super_secret_refresh_key_change_me_in_production_67890"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Ports
BACKEND_PORT=4000
FRONTEND_PORT=5173
CORS_ORIGIN="http://localhost:5173"

# Optional Stripe Integration (Stretch Goal)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
