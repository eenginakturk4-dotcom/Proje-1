# Backend Environment Variables

PORT=4000
NODE_ENV=development

# Database URL (Postgres default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoppy_dev?schema=public"

# SQLite Alternative (for instant local zero-docker development):
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="shoppy_access_token_super_secret_key_12345"
JWT_REFRESH_SECRET="shoppy_refresh_token_super_secret_key_67890"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Frontend Origin
CORS_ORIGIN="http://localhost:5173"

# Optional Stripe Integration
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
